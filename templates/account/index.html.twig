{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap');

        /* -- Arrière-plan festif et animé -- */
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(-45deg, #4b0082, #8a2be2, #4169e1, #00ced1);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            color: #fff;
            margin: 0;
            padding: 2rem 1rem; /* Ajout de padding pour les petits écrans */
            display: flex;
            justify-content: center;
            align-items: flex-start; /* Aligner en haut pour voir le début de la page si elle est longue */
            min-height: 100vh;
        }

        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* -- La carte principale -- */
        .profile-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2em 2.5em;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            width: 100%;
            max-width: 700px;
        }

        h1, h2 {
            text-align: center;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }

        h1 { font-size: 2.5em; margin-bottom: 1em; }
        h2 { font-size: 1.8em; margin-top: 1.5em; margin-bottom: 1em; }

        /* -- Style des champs du formulaire -- */
        .form-group { margin-bottom: 1.5rem; }
        .form-group label { display: block; margin-bottom: 0.5rem; font-weight: bold; }
        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.5);
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            font-size: 1em;
        }
        .form-group input::placeholder { color: rgba(255, 255, 255, 0.7); }

        /* -- Bouton principal -- */
        .btn-primary {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(90deg, #8a2be2 0%, #4169e1 100%);
            color: white;
            font-size: 1.2em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s ease;
            text-transform: uppercase;
        }
        .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2); }

        /* -- Séparateur visuel -- */
        hr {
            border: 0;
            height: 1px;
            background: rgba(255, 255, 255, 0.2);
            margin: 2.5em 0;
        }

        /* -- Liste des groupes -- */
        .groups-list {
            list-style: none;
            padding: 0;
        }

        .group-item {
            background: rgba(0, 0, 0, 0.15);
            padding: 1rem 1.5rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap; /* Pour la réactivité mobile */
            gap: 1rem;
        }

        .group-info {
            flex-grow: 1;
        }

        .group-name {
            font-size: 1.2em;
            font-weight: bold;
            margin: 0;
        }

        .group-role {
            display: inline-block;
            padding: 0.2em 0.6em;
            border-radius: 5px;
            font-size: 0.9em;
            font-weight: bold;
            text-transform: uppercase;
        }

        /* Styles conditionnels pour les rôles */
        .role-admin {
            background-color: #f1c40f; /* Doré */
            color: #333;
        }
        .role-member {
            background-color: #3498db; /* Bleu */
            color: #fff;
        }

        .group-actions .btn-secondary {
            padding: 0.6em 1.2em;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            background: #f1c40f;
            color: #333;
            transition: all 0.2s ease;
            border: none;
            cursor: pointer;
        }
        .group-actions .btn-secondary:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .no-groups {
            text-align: center;
            padding: 2rem;
            background: rgba(0,0,0,0.1);
            border-radius: 10px;
        }

    </style>
{% endblock %}

{% block body %}
    <div class="profile-card">
        <h1>Modifier mon profil</h1>

        {{ form_start(profileForm) }}
        <div class="form-group">
            {{ form_label(profileForm.email) }}
            {{ form_widget(profileForm.email) }}
            {{ form_errors(profileForm.email) }}
        </div>

        {# Ajoutez ici d'autres champs de votre formulaire, ex: nom, prénom #}
        {# Exemple avec un champ 'username'
            <div class="form-group">
                {{ form_label(profileForm.username) }}
                {{ form_widget(profileForm.username) }}
                {{ form_errors(profileForm.username) }}
            </div>
        #}

        <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
        {{ form_end(profileForm) }}

        <hr>

        <h2>Mes Groupes</h2>

        <div class="groups-list">
            {% for membership in memberships %}
                <div class="group-item">
                    <div class="group-info">
                        <p class="group-name">{{ membership.group.name }}</p>
                        {# On ajoute une classe CSS en fonction du rôle pour un style différent #}
                        {% set role_class = (membership.role == 'ROLE_ADMIN' ? 'role-admin' : 'role-member') %}
                        {# On affiche un nom de rôle plus sympa pour l'utilisateur #}
                        {% set role_name = (membership.role == 'ROLE_ADMIN' ? 'Administrateur' : 'Membre') %}

                        <span class="group-role {{ role_class }}">{{ role_name }}</span>
                    </div>

                    <div class="group-actions">
                        {# C'est ici que la magie opère ! #}
                        {# ATTENTION : Remplacez 'ROLE_ADMIN' par le nom exact de votre rôle admin si différent #}
                        {% if membership.role == 'ROLE_ADMIN' %}
                            <a href="{{ path('app_group_settings', {'id': membership.group.id}) }}" class="btn-secondary">
                                Paramètres du groupe
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="no-groups">
                    <p>Vous n'êtes membre d'aucun groupe pour le moment.</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
