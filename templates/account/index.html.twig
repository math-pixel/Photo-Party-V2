{% extends 'base.html.twig' %}

{% block title %}Mon Profil - PhotoParty{% endblock %}

{% block body %}
    <div class="relative min-h-screen bg-slate-50 flex flex-col items-center justify-start px-4 py-12 overflow-hidden font-sans selection:bg-party-purple selection:text-white">

        {# --- DÉCORATION D'ARRIÈRE-PLAN --- #}
        <div class="absolute top-0 right-0 translate-x-1/4 -translate-y-1/4 w-[600px] h-[600px] bg-party-purple/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 -translate-x-1/4 translate-y-1/4 w-[500px] h-[500px] bg-party-blue/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 w-full max-w-2xl">

            {# --- HEADER --- #}
            <div class="text-center mb-10">
                <h1 class="text-4xl font-display font-bold text-slate-900 mb-2">
                    Mon <span class="text-transparent bg-clip-text bg-gradient-to-r from-party-blue to-party-purple">Compte</span>
                </h1>
                <p class="text-slate-500">Gérez vos informations.</p>
            </div>

            {# --- CARTE PROFIL --- #}
            <div class="bg-white rounded-[32px] shadow-xl shadow-slate-200/60 p-8 md:p-10 border border-slate-100 mb-8">
                <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-party-purple">
                        <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
                    </svg>
                    Informations personnelles
                </h2>

                {# --- DÉBUT DU BLOC FLASH MESSAGE --- #}
                {% for message in app.flashes('success') %}
                    <div class="mb-6 bg-green-50 border border-green-200 text-green-800 px-4 py-4 rounded-xl flex items-center gap-3 shadow-sm" role="alert">
                        {# Petite icône de succès #}
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-green-500 shrink-0">
                            <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
                        </svg>
                        <div>
                            <span class="font-bold block">Succès !</span>
                            <span class="text-sm">{{ message }}</span>
                        </div>
                    </div>
                {% endfor %}
                {# --- FIN DU BLOC FLASH MESSAGE --- #}

                {{ form_start(profileForm, { 'attr': { 'class': 'space-y-5' } }) }}

                {# --- GRID PRENOM / NOM --- #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        {{ form_label(profileForm.first_name, 'Prénom', { 'label_attr': { 'class': 'block text-sm font-bold text-slate-700 mb-2 ml-1' } }) }}
                        {{ form_widget(profileForm.first_name, {
                            'attr': {
                                'class': 'w-full px-5 py-3 bg-slate-50 border border-slate-200 text-slate-900 rounded-xl focus:ring-2 focus:ring-party-purple focus:border-transparent outline-none transition-all',
                                'placeholder': 'Votre prénom'
                            }
                        }) }}
                        {{ form_errors(profileForm.first_name) }}
                    </div>
                    <div>
                        {{ form_label(profileForm.last_name, 'Nom', { 'label_attr': { 'class': 'block text-sm font-bold text-slate-700 mb-2 ml-1' } }) }}
                        {{ form_widget(profileForm.last_name, {
                            'attr': {
                                'class': 'w-full px-5 py-3 bg-slate-50 border border-slate-200 text-slate-900 rounded-xl focus:ring-2 focus:ring-party-purple focus:border-transparent outline-none transition-all',
                                'placeholder': 'Votre nom'
                            }
                        }) }}
                        {{ form_errors(profileForm.last_name) }}
                    </div>
                </div>

                {# --- EMAIL --- #}
                <div>
                    {{ form_label(profileForm.email, 'Adresse Email', { 'label_attr': { 'class': 'block text-sm font-bold text-slate-700 mb-2 ml-1' } }) }}
                    {{ form_widget(profileForm.email, {
                        'attr': {
                            'class': 'w-full px-5 py-3 bg-slate-50 border border-slate-200 text-slate-900 rounded-xl focus:ring-2 focus:ring-party-purple focus:border-transparent outline-none transition-all',
                            'placeholder': 'exemple@email.com'
                        }
                    }) }}
                    {{ form_errors(profileForm.email, { 'attr': { 'class': 'text-party-pink text-sm mt-2 ml-1' } }) }}
                </div>

                <div class="pt-4">
                    <button type="submit" class="btn w-full bg-party-purple text-white font-bold py-3 rounded-xl shadow-lg shadow-party-purple/20 hover:bg-party-purple/90 transition-all">
                        Enregistrer les modifications
                    </button>
                </div>

                {{ form_end(profileForm) }}
            </div>

            {# --- FOOTER LINK --- #}
            <div class="text-center mt-8">
                <a href="/" class="text-slate-400 hover:text-slate-600 text-sm font-medium transition-colors">
                    Retour à l'accueil
                </a>
            </div>
        </div>
    </div>
{% endblock %}
