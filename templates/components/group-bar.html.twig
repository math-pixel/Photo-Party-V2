{# URL pour le lien de partage #}
{% set shareUrl = url('app_projection', {id: group.id}) %}

<div class="w-full max-w-4xl mx-auto mb-6"
     data-group-id="{{ group.id }}"
     x-data="{
        isOpen: false,
        shareLink: '{{ shareUrl }}',
        copied: false,
        toggle() { this.isOpen = !this.isOpen },
        copyToClipboard() {
            navigator.clipboard.writeText(this.shareLink);
            this.copied = true;
            setTimeout(() => this.copied = false, 2000);
        }
     }">

    <!-- CARTE PRINCIPALE -->
    <div class="bg-white rounded-[32px] shadow-xl shadow-slate-200/40 border border-slate-100 overflow-hidden transition-all duration-300 hover:shadow-2xl hover:shadow-slate-200/60">

        <!-- 1. HEADER (Cliquable) -->
        <div @click="toggle()" class="p-6 md:p-8 flex items-center justify-between cursor-pointer select-none group relative z-10 bg-white">

            <!-- INFO GROUPE -->
            <div class="flex items-center gap-5">
                <div class="flex-shrink-0 w-16 h-16 rounded-[20px] bg-gradient-to-br from-party-blue to-party-purple flex items-center justify-center text-2xl font-display font-bold text-white shadow-lg shadow-party-purple/20 group-hover:scale-105 transition-transform">
                    {{ group.name|first|upper }}
                </div>
                <div class="flex flex-col justify-center">
                    <h3 class="text-2xl font-display font-bold text-slate-900 leading-tight mb-1 group-hover:text-party-purple transition-colors">
                        {{ group.name }}
                    </h3>
                    <div class="flex items-center gap-2 text-sm text-slate-500 font-medium">
                        <span class="flex items-center gap-1 bg-slate-50 px-2.5 py-1 rounded-lg border border-slate-100">
                            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                            Créé le {{ group.createdAt|date('d M Y') }}
                        </span>
                    </div>
                </div>
            </div>

            <!-- Chevron Animé -->
            <div class="p-2 rounded-full bg-slate-50 text-slate-400 transition-transform duration-300 border border-slate-100 group-hover:border-party-purple/30 group-hover:text-party-purple"
                 :class="{ 'rotate-180 bg-party-purple/10 text-party-purple': isOpen }">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
            </div>
        </div>

        <!-- 2. ACTIONS (Dépliables avec Animation) -->
        <!-- AJOUT DE x-collapse ICI -->
        <div x-show="isOpen"
             x-collapse
             class="border-t border-slate-100 bg-slate-50/50">

            <!-- Le padding est mis ici pour qu'il soit inclus dans l'animation -->
            <div class="px-6 md:px-8 pb-8 pt-6">

                <!-- CONTENEUR BOUTONS -->
                <div class="flex flex-wrap md:flex-nowrap items-center justify-between gap-4">

                    <!-- A. BOUTON LANCER -->
                    <a href="{{ path('app_projection', {id: group.id}) }}"
                       class="btn flex-1 gap-2 px-5 py-3 rounded-xl shadow-none bg-party-yellow/10 text-party-yellow hover:bg-party-yellow hover:text-white hover:shadow-lg hover:shadow-party-yellow/30 transition-all duration-200 whitespace-nowrap justify-center"
                       title="Lancer la projection">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                        </svg>
                        Projeter Photos
                    </a>

                    <!-- B. BOUTON AJOUTER PHOTO -->
                    <a href="{{ path('app_client', {id: group.id}) }}"
                       class="btn flex-1 gap-2 px-5 py-3 rounded-xl shadow-none bg-party-pink/10 text-party-pink hover:bg-party-pink hover:text-white hover:shadow-lg hover:shadow-party-pink/30 transition-all duration-200 whitespace-nowrap justify-center"
                       title="Ajouter une photo">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                        </svg>
                        Ajouter Photo
                    </a>

                    <!-- C. BOUTON PARTAGER -->
                    <button
                        @click.stop="copyToClipboard()"
                        class="btn flex-1 gap-2 px-5 py-3 rounded-xl shadow-none transition-all duration-200 whitespace-nowrap justify-center"
                        :class="copied ? 'bg-green-100 text-green-700 hover:bg-green-200' : 'bg-party-blue/10 text-party-blue hover:bg-party-blue hover:text-white hover:shadow-lg hover:shadow-party-blue/30'"
                        title="Partager le lien">
                        <svg x-show="!copied" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
                        </svg>
                        <svg x-cloak x-show="copied" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        <span x-text="copied ? 'Lien copié !' : 'Partager'"></span>
                    </button>

                    <!-- D. BOUTON REGLAGES -->
                    {% if group.isOwnedBy(app.user) == app.user %}
                        <a href="{{ path('group_administration', {id: group.id}) }}"
                           class="btn flex-1 gap-2 px-5 py-3 rounded-xl shadow-none bg-party-orange/10 text-party-orange hover:bg-party-orange hover:text-white hover:shadow-lg hover:shadow-party-orange/30 transition-all duration-200 whitespace-nowrap justify-center"
                           title="Paramètres du groupe">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span class="hidden sm:inline">Réglages</span>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- IMPORTANT : Assure-toi que Alpine.js est bien chargé dans ton base.html.twig -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
{# Si tu veux l'animation fluide 'x-collapse', ajoute aussi ce plugin : #}
<script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
