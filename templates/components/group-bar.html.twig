<div class="group-bar" data-group-id="{{ group.id }}" x-data="{ isOpen: false }">
    <!-- BARRE PRINCIPALE (toujours visible) -->
    <button
        @click="isOpen = !isOpen"
        class="w-full flex items-center justify-between px-6 py-4 bg-white border-b border-gray-200 hover:bg-gray-50 transition-colors duration-200"
    >
        <!-- CÔTÉ GAUCHE : Flèche + Nom -->
        <div class="flex items-center gap-4">
            <!-- Flèche de toggle -->
            <svg
                class="w-5 h-5 text-gray-600 transition-transform duration-200"
                :class="{ 'rotate-90': isOpen }"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>

            <!-- Nom du groupe -->
            <span class="text-lg font-semibold text-gray-900">{{ group.name }} - {{ group.id }}</span>
        </div>

        <div class="flex items-center gap-4">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
                <!-- Projecteur (carré) -->
                <rect x="2" y="8" width="6" height="6" />

                <!-- Entonnoir de projection vers la droite -->
                <line x1="8" y1="8" x2="15" y2="5" />
                <line x1="8" y1="14" x2="15" y2="17" />
            </svg>

            <!-- CÔTÉ DROIT : Logo partager -->
            <!-- Share Network -->
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
        </div>
    </button>

    <!-- CONTENU DÉPLIABLE (visible quand isOpen = true) -->
    <div
        class="bg-gray-50 border-b border-gray-200 overflow-hidden transition-all duration-300"
        :class="{ 'max-h-20': isOpen, 'max-h-0': !isOpen }"
    >
        <div class="flex items-center justify-between px-6 py-3">
            <!-- CÔTÉ GAUCHE : Date de création -->
            <span class="text-sm text-gray-600">
        Créé le {{ group.createdAt|date('d/m/Y') }}
      </span>

            <!-- CÔTÉ DROIT : Icônes édition et paramètres -->
            <div class="flex items-center gap-4">
                <!-- Icône édition -->
                <button
                    class="p-2 rounded-lg hover:bg-gray-200 transition-colors"
                    title="Éditer le groupe"
                >
                    <svg
                        class="w-5 h-5 text-gray-600 hover:text-teal-600 transition-colors"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                </button>

                <!-- Icône paramètres -->
                <button
                    class="p-2 rounded-lg hover:bg-gray-200 transition-colors"
                    title="Paramètres du groupe"
                >
                    <svg
                        class="w-5 h-5 text-gray-600 hover:text-teal-600 transition-colors"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Alpine.js requis pour x-data et @click -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

<style>
    /* Animation smooth du toggle */
    [x-cloak] { display: none; }
</style>
