<div class="w-full max-w-4xl mx-auto mb-6" data-group-id="{{ group.id }}">

    <!-- CARTE -->
    <div class="bg-white rounded-[32px] shadow-xl shadow-slate-200/40 border border-slate-100 p-6 md:p-8 transition-shadow duration-300 hover:shadow-2xl hover:shadow-slate-200/60">

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">

            <!-- 1. INFO GROUPE -->
            <div class="flex items-center gap-5">
                <!-- Avatar -->
                <div class="flex-shrink-0 w-16 h-16 rounded-[20px] bg-gradient-to-br from-party-blue to-party-purple flex items-center justify-center text-2xl font-display font-bold text-white shadow-lg shadow-party-purple/20">
                    {{ group.name|first|upper }}
                </div>

                <!-- Textes -->
                <div class="flex flex-col justify-center">
                    <h3 class="text-xl font-display font-bold text-slate-900 leading-tight mb-1">
                        {{ group.name }}
                    </h3>
                    <div class="flex items-center gap-2 text-sm text-slate-500 font-medium">
                        <span class="flex items-center gap-1 bg-slate-50 px-2 py-1 rounded-lg">
                            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                            {{ group.createdAt|date('d M Y') }}
                        </span>
                    </div>
                </div>
            </div>

            <!-- 2. ACTIONS -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto">

                <!-- BOUTON LANCER (Violet) -->
                <a href="{{ path('app_projection', {id: group.id}) }}"
                   class="btn flex-1 sm:flex-none gap-2 px-5 py-3 rounded-xl shadow-none bg-party-purple/10 text-party-purple hover:bg-party-purple hover:text-white hover:shadow-lg hover:shadow-party-purple/30"
                   title="Lancer la projection">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
                    </svg>
                    Lancer
                </a>

                <!-- BOUTON PARTAGER (Bleu) -->
                <!-- Note : href="#" car c'est souvent une action JS -->
                <a href="#"
                   class="btn flex-1 sm:flex-none gap-2 px-5 py-3 rounded-xl shadow-none bg-party-blue/10 text-party-blue hover:bg-party-blue hover:text-white hover:shadow-lg hover:shadow-party-blue/30"
                   title="Partager le lien">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
                    </svg>
                    Partager
                </a>

                <!-- BOUTON REGLAGES (Orange) -->
                <a href="{{ path('app_main', {id: group.id}) }}"
                   class="btn flex-1 sm:flex-none gap-2 px-5 py-3 rounded-xl shadow-none bg-party-orange/10 text-party-orange hover:bg-party-orange hover:text-white hover:shadow-lg hover:shadow-party-orange/30"
                   title="Paramètres du groupe">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span class="hidden md:inline">Réglages</span>
                </a>

            </div>
        </div>
    </div>
</div>
