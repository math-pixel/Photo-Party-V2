{# templates/group/create.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Créer un groupe{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap');

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(-45deg, #667eea, #764ba2, #f093fb, #4facfe);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            color: #fff;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
        }

        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .create-group-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2.5em;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            width: 100%;
            max-width: 550px;
            z-index: 10;
        }

        h1 {
            text-align: center;
            font-size: 2.5em;
            margin-bottom: 1em;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: bold;
        }

        .form-group input[type="text"],
        .form-group input[type="url"] {
            width: 100%;
            padding: 12px 15px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.5);
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            font-size: 1em;
            transition: all 0.3s ease;
        }

        .form-group input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        .form-group input:focus {
            outline: none;
            border-color: #fff;
            box-shadow: 0 0 10px rgba(102, 126, 234, 0.5);
        }

        /* Messages d'erreur */
        .form-error {
            color: #ff6b6b;
            background: rgba(255, 107, 107, 0.2);
            padding: 0.5rem;
            border-radius: 5px;
            margin-top: 0.5rem;
            font-size: 0.9em;
        }

        button[type="submit"] {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
            color: white;
            font-size: 1.2em;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            text-transform: uppercase;
            margin-top: 1rem;
        }

        button[type="submit"]:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

        .confetti-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }

        .confetti {
            position: absolute;
            width: 10px;
            height: 10px;
            background-color: #f0f;
            animation: fall linear infinite;
        }

        @keyframes fall {
            to {
                transform: translateY(110vh) rotateZ(360deg);
            }
        }

        {% for i in 1..20 %}
        .confetti:nth-child({{ i }}) {
            left: {{ random(0, 100) }}%;
            background-color: {{ random(['#ffc300', '#ff5733', '#c70039', '#667eea', '#4facfe', '#f093fb']) }};
            width: {{ random(5, 15) }}px;
            height: {{ random(5, 15) }}px;
            animation-duration: {{ random(5, 15) }}s;
            animation-delay: -{{ random(0, 10) }}s;
            opacity: {{ random(5, 10) / 10 }};
        }
        {% endfor %}

        /* Aide visuelle */
        .form-help {
            font-size: 0.85em;
            color: rgba(255, 255, 255, 0.8);
            margin-top: 0.3rem;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="confetti-container">
        {% for i in 1..20 %}
            <div class="confetti"></div>
        {% endfor %}
    </div>

    <div class="create-group-card">
        <h1>✨ Créer un groupe ✨</h1>

        {{ form_start(groupForm) }}
        <div class="form-group">
            {{ form_label(groupForm.name) }}
            {{ form_widget(groupForm.name) }}
            {{ form_errors(groupForm.name) }}
            <small class="form-help">Choisissez un nom qui décrit bien votre événement</small>
        </div>

        <div class="form-group">
            {{ form_label(groupForm.url_image1) }}
            {{ form_widget(groupForm.url_image1) }}
            {{ form_errors(groupForm.url_image1) }}
            <small class="form-help">Optionnel - URL d'une image de couverture</small>
        </div>

        <div class="form-group">
            {{ form_label(groupForm.url_image2) }}
            {{ form_widget(groupForm.url_image2) }}
            {{ form_errors(groupForm.url_image2) }}
            <small class="form-help">Optionnel - URL d'une image secondaire</small>
        </div>

        <button type="submit">Créer le groupe</button>
        {{ form_end(groupForm) }}
    </div>
{% endblock %}
