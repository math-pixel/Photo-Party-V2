{% extends 'base.html.twig' %}

{% block title %}Créer un groupe{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
        <div class="w-full max-w-md bg-white rounded-lg shadow-md p-8">
            <h1 class="text-3xl font-bold text-center text-gray-900 mb-8">Créer un groupe</h1>

            {{ form_start(groupForm, { 'attr': { 'class': 'space-y-6' } }) }}

            <div>
                {{ form_label(groupForm.name, 'Nom du groupe', { 'label_attr': { 'class': 'block text-sm font-medium text-gray-700 mb-2' } }) }}
                {{ form_widget(groupForm.name, { 'attr': { 'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition' } }) }}
                {{ form_errors(groupForm.name, { 'attr': { 'class': 'text-red-600 text-sm mt-1' } }) }}
            </div>

            <div>
                {{ form_label(groupForm.url_image1, 'Image de couverture (URL)', { 'label_attr': { 'class': 'block text-sm font-medium text-gray-700 mb-2' } }) }}
                {{ form_widget(groupForm.url_image1, { 'attr': { 'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition' } }) }}
                {{ form_errors(groupForm.url_image1, { 'attr': { 'class': 'text-red-600 text-sm mt-1' } }) }}
                <p class="text-xs text-gray-500 mt-1">Optionnel</p>
            </div>

            <div>
                {{ form_label(groupForm.url_image2, 'Image secondaire (URL)', { 'label_attr': { 'class': 'block text-sm font-medium text-gray-700 mb-2' } }) }}
                {{ form_widget(groupForm.url_image2, { 'attr': { 'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent transition' } }) }}
                {{ form_errors(groupForm.url_image2, { 'attr': { 'class': 'text-red-600 text-sm mt-1' } }) }}
                <p class="text-xs text-gray-500 mt-1">Optionnel</p>
            </div>

            <button type="submit" class="w-full py-3 mt-8 bg-teal-600 hover:bg-teal-700 text-white font-semibold rounded-lg transition duration-200 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2">
                Créer le groupe
            </button>

            {{ form_end(groupForm) }}
        </div>
    </div>
{% endblock %}
