{% extends 'base.html.twig' %}

{% block title %}Administration Groupe - PhotoParty{% endblock %}

{% block body %}
    <div class="relative min-h-screen bg-slate-50 py-8 px-4 sm:px-6 lg:px-8 font-sans selection:bg-party-purple selection:text-white">

        {# --- DÉCOR D'ARRIÈRE-PLAN (Blobs) --- #}
        <div class="fixed top-0 left-0 w-[500px] h-[500px] bg-party-yellow/5 rounded-full blur-3xl pointer-events-none -translate-x-1/2 -translate-y-1/2"></div>
        <div class="fixed bottom-0 right-0 w-[400px] h-[400px] bg-party-blue/5 rounded-full blur-3xl pointer-events-none translate-x-1/3 translate-y-1/3"></div>

        <div class="relative z-10 max-w-[1600px] mx-auto">

            {# HEADER SIMPLE #}
            <div class="flex items-center gap-4 mb-8">
                <a href="{{ path('app_home') }}" class="p-2 rounded-full bg-white border border-slate-200 text-slate-400 hover:text-party-purple transition-colors shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                    </svg>
                </a>
                <h1 class="text-3xl font-display font-bold text-slate-900">
                    Administration du <span class="text-transparent bg-clip-text bg-gradient-to-r from-party-pink to-party-orange">Groupe</span>
                </h1>
            </div>

            {# --- LAYOUT PRINCIPAL (Grille) --- #}
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 items-start">

                {# ================================================= #}
                {# COLONNE GAUCHE : GALERIE (3/4 de l'écran) #}
                {# ================================================= #}
                <div class="lg:col-span-3 bg-white rounded-[32px] shadow-xl shadow-slate-200/60 border border-slate-100 p-6 md:p-8 min-h-[600px]">

                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-display font-bold text-slate-900 flex items-center gap-3">
                            Galerie Photo
                            <span class="bg-slate-100 text-slate-500 text-xs font-bold px-2.5 py-1 rounded-lg border border-slate-200">
                                {{ photos|length }} photos
                            </span>
                        </h2>

                        {# Légende rapide #}
                        <div class="flex gap-4 text-xs font-medium text-slate-400">
                            <div class="flex items-center gap-1">
                                <div class="w-3 h-3 rounded-full bg-slate-200 border border-slate-300"></div> Visible
                            </div>
                            <div class="flex items-center gap-1">
                                <div class="w-3 h-3 rounded-full bg-slate-800 border border-slate-900"></div> Masquée
                            </div>
                        </div>
                    </div>

                    {# GRILLE DES PHOTOS #}
                    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4">
                        {% for photo in photos %}
                            <div
                                x-data="{
                                    isHidden: {{ photo.isAllowed ? 'false' : 'true' }},
                                    isLoading: false,
                                    photoId: {{ photo.id }},

                                    async toggleVisibility() {
                                        // 1. Anti-spam clic
                                        if (this.isLoading) return;

                                        // 2. Sauvegarde l'état précédent en cas d'erreur
                                        const previousState = this.isHidden;

                                        // 3. Mise à jour Optimiste (On change l'UI tout de suite)
                                        this.isHidden = !this.isHidden;
                                        this.isLoading = true;

                                        // 4. Préparation des données
                                        const formData = new FormData();
                                        formData.append('photoID', this.photoId);
                                        // Si c'est caché, isAllowed = 0 (false), sinon 1 (true)
                                        formData.append('isAllowed', this.isHidden ? '0' : '1');

                                        try {
                                            const response = await fetch('{{ path('api_photo_upload') }}', {
                                                method: 'POST',
                                                body: formData
                                            });

                                            if (!response.ok) throw new Error('Erreur serveur');

                                            // Optionnel : console.log('Sauvegardé');

                                        } catch (error) {
                                            console.error(error);
                                            // 5. En cas d'erreur, on annule le changement visuel
                                            this.isHidden = previousState;
                                            alert('Impossible de modifier l\'état de la photo.');
                                            console.log(error)
                                        } finally {
                                            this.isLoading = false;
                                        }
                                    }
                                }"
                                @click="toggleVisibility()"
                                class="group relative aspect-square rounded-2xl overflow-hidden cursor-pointer transition-transform hover:scale-[1.02] hover:shadow-lg"
                                :class="[
                                    isHidden ? 'ring-4 ring-slate-900' : 'ring-1 ring-slate-200',
                                    isLoading ? 'opacity-70 cursor-wait' : ''
                                ]">

                                {# L'image #}
                                <img src="{{ [app.request.getBaseURL(), default_path_image, photo.imageName]|join }}"
                                     alt="Photo {{ photo.id }}"
                                     class="w-full h-full object-cover transition-all duration-300"
                                     :class="isHidden ? 'grayscale blur-[2px] scale-110' : ''"
                                >

                                {# L'Overlay (Div grise par dessus) #}
                                <div class="absolute inset-0 bg-slate-900/70 flex flex-col items-center justify-center text-white transition-opacity duration-200"
                                     x-show="isHidden"
                                     x-transition:enter="transition ease-out duration-200"
                                     x-transition:enter-start="opacity-0"
                                     x-transition:enter-end="opacity-100">

                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8 mb-1 text-party-pink">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.45 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                                    </svg>
                                    <span class="text-xs font-bold uppercase tracking-wider">Masquée</span>
                                </div>

                                {# Petit indicateur de chargement (Spinner optionnel) #}
                                <div x-show="isLoading" class="absolute top-2 right-2">
                                    <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                                    </svg>
                                </div>

                                {# Petit indicateur au survol quand visible #}
                                <div class="absolute inset-0 bg-party-purple/20 opacity-0 group-hover:opacity-100 transition-opacity duration-200" x-show="!isHidden && !isLoading"></div>
                            </div>
                        {% endfor %}

                        {# Placeholder vide si pas de photo #}
                        {% if photos is empty %}
                            <div class="col-span-full py-20 text-center">
                                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                                    <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.008v.008h-.008V10z"></path></svg>
                                </div>
                                <p class="text-slate-500">Aucune photo n'a encore été postée.</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# ================================================= #}
                {# COLONNE DROITE : PARAMÈTRES (1/4 de l'écran) #}
                {# ================================================= #}
                <div class="lg:col-span-1 lg:sticky lg:top-6">
                    <div class="bg-white rounded-[32px] shadow-xl shadow-slate-200/60 border border-slate-100 p-6 flex flex-col gap-6">

                        {# TITRE #}
                        <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
                            <div class="w-10 h-10 rounded-xl bg-party-orange/10 text-party-orange flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <h2 class="text-lg font-display font-bold text-slate-900">Réglages</h2>
                        </div>

                        {{ form_start(formAdmin, {'attr': {'class': 'flex flex-col gap-6'}}) }}

                        {# --- NOM DU GROUPE --- #}
                        <div>
                            <div class="flex justify-between items-center mb-1 ml-1">
                                {{ form_label(formAdmin.name, 'Nom du groupe', {'label_attr': {'class': 'text-sm font-bold text-slate-700'}}) }}
                                {% if group.name %}
                                    <span class="text-[10px] font-bold text-party-purple bg-party-purple/10 px-2 py-0.5 rounded-full">Défini</span>
                                {% endif %}
                            </div>
                            {# Condition de style : Si rempli, bordure violette. Sinon gris standard #}
                            {% set nameClass = group.name ? 'border-party-purple/50 bg-party-purple/5 text-slate-900 focus:ring-party-purple' : 'border-slate-200 bg-slate-50 text-slate-900 focus:ring-party-purple' %}
                            {{ form_widget(formAdmin.name, {'attr': {'class': 'w-full px-4 py-2 rounded-xl text-sm border transition ' ~ nameClass }}) }}
                        </div>

                        {# --- DESCRIPTION --- #}
                        <div>
                            <div class="flex justify-between items-center mb-1 ml-1">
                                {{ form_label(formAdmin.description, 'Message d\'invitation', {'label_attr': {'class': 'text-sm font-bold text-slate-700'}}) }}
                                {% if group.description %}
                                    <span class="text-[10px] font-bold text-party-purple bg-party-purple/10 px-2 py-0.5 rounded-full">Défini</span>
                                {% endif %}
                            </div>
                            {% set descClass = group.description ? 'border-party-purple/50 bg-party-purple/5 text-slate-900 focus:ring-party-purple' : 'border-slate-200 bg-slate-50 text-slate-900 focus:ring-party-purple' %}
                            {{ form_widget(formAdmin.description, {'attr': {'class': 'w-full px-4 py-2 rounded-xl text-sm border resize-none transition ' ~ descClass, 'rows': 3}}) }}
                        </div>

                        <div class="h-px w-full bg-slate-100"></div>

                        {# --- GESTION DES IMAGES (Avec Prévisualisation) --- #}
                        <div class="space-y-5">

                            {# IMAGE 1 #}
                            <div>
                                <div class="flex justify-between items-center mb-2 ml-1">
                                    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Image Principale</span>
                                </div>

                                <div class="p-3 bg-slate-50 border border-slate-200 rounded-2xl">
                                    {# Si une image existe, on l'affiche #}
                                    {% if group.image1Name %}
                                        <div class="relative w-full h-32 mb-3 rounded-xl overflow-hidden border border-slate-200 group">
                                            <img src="{{ vich_uploader_asset(group, 'image1File') }}" alt="Cover" class="w-full h-full object-cover">
                                            <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"></div>
                                            <div class="absolute bottom-2 right-2">
                                                <span class="text-[10px] font-bold bg-white/90 text-slate-800 px-2 py-1 rounded-md shadow-sm">Actuelle</span>
                                            </div>
                                        </div>
                                    {% endif %}

                                    {# Input File #}
                                    {{ form_widget(formAdmin.image1File.file, {'attr': {'class': 'w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-white file:text-party-purple file:shadow-sm hover:file:bg-party-purple hover:file:text-white cursor-pointer transition-all'}}) }}

                                    {# Checkbox Supprimer (si existe) #}
                                    {% if formAdmin.image1File.delete is defined %}
                                        <div class="mt-3 pt-2 border-t border-slate-200 flex items-center gap-2">
                                            {{ form_widget(formAdmin.image1File.delete, {'attr': {'class': 'w-4 h-4 rounded border-slate-300 text-red-500 focus:ring-red-500'}}) }}
                                            <span class="text-xs text-slate-500">Supprimer l'image</span>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            {# IMAGE 2 #}
                            <div>
                                <div class="flex justify-between items-center mb-2 ml-1">
                                    <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Image Secondaire</span>
                                </div>

                                <div class="p-3 bg-slate-50 border border-slate-200 rounded-2xl">
                                    {% if group.image2Name %}
                                        <div class="relative w-full h-24 mb-3 rounded-xl overflow-hidden border border-slate-200">
                                            <img src="{{ vich_uploader_asset(group, 'image2File') }}" alt="Secondary" class="w-full h-full object-cover">
                                            <div class="absolute bottom-2 right-2">
                                                <span class="text-[10px] font-bold bg-white/90 text-slate-800 px-2 py-1 rounded-md shadow-sm">Actuelle</span>
                                            </div>
                                        </div>
                                    {% endif %}

                                    {{ form_widget(formAdmin.image2File.file, {'attr': {'class': 'w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-white file:text-party-purple file:shadow-sm hover:file:bg-party-purple hover:file:text-white cursor-pointer transition-all'}}) }}

                                    {% if formAdmin.image2File.delete is defined %}
                                        <div class="mt-3 pt-2 border-t border-slate-200 flex items-center gap-2">
                                            {{ form_widget(formAdmin.image2File.delete, {'attr': {'class': 'w-4 h-4 rounded border-slate-300 text-red-500 focus:ring-red-500'}}) }}
                                            <span class="text-xs text-slate-500">Supprimer l'image</span>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="h-px w-full bg-slate-100"></div>

                        {# --- TOGGLES --- #}
                        <div class="space-y-4">

                            <div class="flex items-center justify-between">
                                <div class="flex flex-col">
                                    <span class="text-sm font-bold text-slate-700">Contenu explicite</span>
                                    <span class="text-[10px] text-slate-400">Actuellement : <span class="{{ group.isExplicit ? 'text-party-pink font-bold' : 'text-slate-500' }}">{{ group.isExplicit ? 'OUI' : 'NON' }}</span></span>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    {{ form_widget(formAdmin.isExplicit, {'attr': {'class': 'sr-only peer'}}) }}
                                    <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-party-pink"></div>
                                </label>
                            </div>

                            <div class="flex items-center justify-between">
                                <div class="flex flex-col">
                                    <span class="text-sm font-bold text-slate-700">Modération</span>
                                    <span class="text-[10px] text-slate-400">Actuellement : <span class="{{ group.isModerated ? 'text-party-purple font-bold' : 'text-slate-500' }}">{{ group.isModerated ? 'ACTIVE' : 'INACTIVE' }}</span></span>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    {{ form_widget(formAdmin.isModerated, {'attr': {'class': 'sr-only peer'}}) }}
                                    <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-party-purple"></div>
                                </label>
                            </div>

                        </div>

                        {# --- BOUTON SUBMIT --- #}
                        <div class="pt-4 mt-auto">
                            <button type="submit" class="btn btn-primary w-full py-3 text-sm shadow-lg shadow-slate-900/20">
                                Enregistrer les changements
                            </button>
                        </div>

                        {{ form_row(formAdmin._token) }}
                        {{ form_end(formAdmin, {'render_rest': false}) }}
                    </div>
                </div>

            </div>
        </div>
    </div>

    {# Script pour Alpine JS (s'il n'est pas déjà dans base.html.twig) #}
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
{% endblock %}
