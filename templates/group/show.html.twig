{% extends 'base.html.twig' %}

{% block title %}{{ group.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap');

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(-45deg, #667eea, #764ba2, #f093fb, #4facfe);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            color: #fff;
            margin: 0;
            padding: 2rem 1rem;
            min-height: 100vh;
        }

        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Header du groupe */
        .group-header {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2em;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

        .group-header h1 {
            font-size: 2.5em;
            margin: 0 0 0.5em 0;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }

        .group-meta {
            display: flex;
            gap: 2rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .meta-item strong {
            opacity: 0.8;
        }

        /* Token avec bouton copier */
        .token-container {
            background: rgba(0, 0, 0, 0.2);
            padding: 1rem;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .token-value {
            font-family: monospace;
            font-size: 1.1em;
            word-break: break-all;
        }

        .btn-copy {
            padding: 0.5rem 1rem;
            background: #f1c40f;
            color: #333;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-copy:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        /* Images de couverture */
        .group-images {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .group-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 10px;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        /* Sections */
        .section {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2em;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            margin-bottom: 2rem;
        }

        .section h2 {
            font-size: 1.8em;
            margin-top: 0;
            margin-bottom: 1em;
            border-bottom: 2px solid rgba(255, 255, 255, 0.2);
            padding-bottom: 0.5em;
        }

        /* Liste des membres */
        .members-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1rem;
        }

        .member-card {
            background: rgba(0, 0, 0, 0.15);
            padding: 1rem;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s ease;
        }

        .member-card:hover {
            background: rgba(0, 0, 0, 0.25);
            transform: translateY(-2px);
        }

        .member-info {
            flex-grow: 1;
        }

        .member-name {
            font-weight: bold;
            margin-bottom: 0.3rem;
        }

        .member-role {
            display: inline-block;
            padding: 0.2em 0.6em;
            border-radius: 5px;
            font-size: 0.85em;
            font-weight: bold;
            text-transform: uppercase;
        }

        .role-admin { background-color: #f1c40f; color: #333; }
        .role-moderator { background-color: #e67e22; color: #fff; }
        .role-member { background-color: #3498db; color: #fff; }

        /* Galerie de photos */
        .photos-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1rem;
        }

        .photo-item {
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            aspect-ratio: 1;
            cursor: pointer;
            transition: transform 0.2s ease;
        }

        .photo-item:hover {
            transform: scale(1.05);
        }

        .photo-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .photo-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
            padding: 0.5rem;
            font-size: 0.85em;
        }

        /* Boutons d'action */
        .action-buttons {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: 1.5rem;
        }

        .btn {
            padding: 0.8rem 1.5rem;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-success {
            background: linear-gradient(90deg, #56ab2f 0%, #a8e063 100%);
            color: white;
        }

        .btn-danger {
            background: linear-gradient(90deg, #eb3349 0%, #f45c43 100%);
            color: white;
        }

        .btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

        /* État vide */
        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            background: rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }

        .empty-state p {
            font-size: 1.2em;
            opacity: 0.8;
            margin-bottom: 1rem;
        }

        /* Badge de compte */
        .count-badge {
            background: rgba(255, 255, 255, 0.2);
            padding: 0.2em 0.6em;
            border-radius: 20px;
            font-size: 0.9em;
            margin-left: 0.5rem;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .group-header h1 {
                font-size: 1.8em;
            }

            .members-grid,
            .photos-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">

        {# Header du groupe avec les infos principales #}
        <div class="group-header">
            <h1>{{ group.name }}</h1>

            <div class="group-meta">
                <div class="meta-item">
                    <strong>📅 Créé le :</strong>
                    <span>{{ group.createdAt|date('d/m/Y à H:i') }}</span>
                </div>
                <div class="meta-item">
                    <strong>👥 Membres :</strong>

                </div>

                <div class="meta-item">
                    <strong>📸 Photos :</strong>

                </div>
            </div>

            {# Token pour partager le groupe #}
            <div class="token-container">
                <div>
                    <strong>🔗 Lien de partage :</strong>
                    <div class="token-value" id="groupToken">{{ group.token }}</div>
                </div>
                <button class="btn-copy" onclick="copyToken()">📋 Copier</button>
            </div>

            {# Images de couverture #}
            {% if group.urlImage1 or group.urlImage2 %}
                <div class="group-images">
                    {% if group.urlImage1 %}
                        <img src="{{ group.urlImage1 }}" alt="Image de couverture" class="group-image">
                    {% endif %}
                    {% if group.urlImage2 %}
                        <img src="{{ group.urlImage2 }}" alt="Image secondaire" class="group-image">
                    {% endif %}
                </div>
            {% endif %}

            {# Boutons d'action (seulement pour les admins/modérateurs) #}
            {% if userRole is defined and userRole == "ROLE_ADMIN" %}
                <div class="action-buttons">
                    <a href="{{ path('app_main', {'id': group.id}) }}" class="btn btn-primary">
                        ⚙️ Paramètres du groupe
                    </a>
                    <a href="{{ path('app_main', {'id': group.id}) }}" class="btn btn-success">
                        ➕ Inviter des membres
                    </a>
                </div>
            {% endif %}
        </div>

        {# Section Membres #}
        <div class="section">
            <h2>
                👥 Membres
            </h2>

            {% if group.userGroups|length > 0 %}
                <div class="members-grid">
                    {% for userGroup in group.userGroups %}
                        <div class="member-card">
                            <div class="member-info">
                                <div class="member-name">
                                    {{ userGroup.user.userIdentifier }}
                                </div>
                                <span class="member-role role-{{ userGroup.role.value|lower|replace({'role_': ''}) }}">
                                    {{ userGroup.role.label }}
                                </span>
                            </div>

                            {# Boutons d'action pour les admins #}
                            {% if userRole is defined and userRole == constant('App\\Enum\\GroupRole::ADMIN') and userGroup.user != app.user %}
                                <div class="member-actions">
                                    {# Ici vous pouvez ajouter des boutons pour promouvoir/rétrograder/supprimer #}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <p>Aucun membre pour le moment.</p>
                    <a href="{{ path('app_group_invite', {'id': group.id}) }}" class="btn btn-success">
                        Inviter des membres
                    </a>
                </div>
            {% endif %}
        </div>

        {# Section Photos #}
        <div class="section">
            <h2>
                📸 Galerie
                <span class="count-badge">{{ group.photos|length }}</span>
            </h2>

            {% if group.photos|length > 0 %}
                <div class="photos-grid">
                    {% for photo in group.photos %}
                        <div class="photo-item" onclick="openPhoto('{{ photo.url }}')">
                            <img src="{{ photo.url }}" alt="Photo {{ loop.index }}">
                            <div class="photo-overlay">
                                <div>Par {{ photo.userId.userIdentifier }}</div>
                                <div>{{ photo.createdAt|date('d/m/Y') }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <p>Aucune photo n'a encore été ajoutée.</p>
                    <a href="{{ path('app_photo_upload', {'groupId': group.id}) }}" class="btn btn-success">
                        📤 Ajouter des photos
                    </a>
                </div>
            {% endif %}
        </div>

        {# Bouton retour #}
        <div style="text-align: center; margin-top: 2rem;">
            <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">
                ← Retour à mes groupes
            </a>
        </div>

    </div>

    <script>
        // Fonction pour copier le token
        function copyToken() {
            const tokenText = document.getElementById('groupToken').textContent;

            navigator.clipboard.writeText(tokenText).then(() => {
                const button = document.querySelector('.btn-copy');
                const originalText = button.textContent;

                button.textContent = '✅ Copié !';
                button.style.background = '#2ecc71';

                setTimeout(() => {
                    button.textContent = originalText;
                    button.style.background = '#f1c40f';
                }, 2000);
            }).catch(err => {
                alert('Erreur lors de la copie : ' + err);
            });
        }

        // Fonction pour ouvrir une photo en grand (vous pouvez améliorer avec une lightbox)
        function openPhoto(url) {
            window.open(url, '_blank');
        }
    </script>
{% endblock %}
