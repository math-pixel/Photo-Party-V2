{% extends 'base.html.twig' %}

{% block title %}{{ group.name }}{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

            {# Header du groupe avec les infos principales #}
            <div class="bg-white rounded-lg shadow-md p-6 sm:p-8 mb-6 border border-gray-200">
                <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">{{ group.name }}</h1>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
                    <div class="flex items-center gap-2">
                        <span class="font-semibold text-gray-700">📅 Créé le :</span>
                        <span class="text-gray-600">{{ group.createdAt|date('d/m/Y à H:i') }}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="font-semibold text-gray-700">👥 Membres :</span>
                        <span class="text-gray-600">{{ group.usergroups|length }}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="font-semibold text-gray-700">📸 Photos :</span>
                        <span class="text-gray-600">{{ group.photos|length }}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="font-semibold text-gray-700">👤 Your role :</span>
                        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold
                                {% if userRole == 'ROLE_ADMIN' %}
                                    bg-yellow-100 text-yellow-800
                                {% elseif userRole == 'ROLE_MODERATOR' %}
                                    bg-orange-100 text-orange-800
                                {% else %}
                                    bg-blue-100 text-blue-800
                                {% endif %}
                            ">
                                {{ userRole }}
                            </span>
                    </div>
                </div>

                {% if userRole is defined and userRole == "ROLE_ADMIN" %}
                    {# Token pour partager le groupe #}
                    <div class="bg-gray-100 border border-gray-300 rounded-lg p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
                        <div>
                            <p class="font-semibold text-gray-700 mb-2">🔗 Lien de partage :</p>
                            <div class="font-mono text-sm text-gray-600 break-all" id="groupToken">{{ group.token }}</div>
                        </div>
                        <button onclick="copyToken()" class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white font-semibold rounded-lg transition-colors duration-200 whitespace-nowrap">
                            📋 Copier
                        </button>
                    </div>

                    {# Images de couverture #}
                    {% if group.urlImage1 or group.urlImage2 %}
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                            {% if group.urlImage1 %}
                                <img src="{{ group.urlImage1 }}" alt="Image de couverture" class="w-full h-48 object-cover rounded-lg border border-gray-200">
                            {% endif %}
                            {% if group.urlImage2 %}
                                <img src="{{ group.urlImage2 }}" alt="Image secondaire" class="w-full h-48 object-cover rounded-lg border border-gray-200">
                            {% endif %}
                        </div>
                    {% endif %}

                    {# Boutons d'action (seulement pour les admins/modérateurs) #}
                    <div class="flex flex-col sm:flex-row gap-4">
                        <a href="{{ path('app_main', {'id': group.id}) }}" class="btn px-6 py-2 bg-teal-600 hover:bg-teal-700 text-white font-semibold rounded-lg transition-colors duration-200 text-center">
                            ⚙️ Paramètres du groupe
                        </a>
                        <a href="{{ path('app_main', {'id': group.id}) }}" class="btn px-6 py-2 bg-teal-600 hover:bg-teal-700 text-white font-semibold rounded-lg transition-colors duration-200 text-center">
                            ➕ Inviter des membres
                        </a>
                    </div>
                {% endif %}
            </div>

            {% if userRole is defined and userRole == "ROLE_ADMIN" %}
                <div class="bg-white rounded-lg shadow-md p-6 sm:p-8 mb-6 border border-gray-200">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b border-gray-200">
                        👥 Membres
                    </h2>

                    {% if group.userGroups|length > 0 %}
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                            {% for userGroup in group.userGroups %}
                                <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 hover:bg-gray-100 transition-colors duration-200 flex justify-between items-start">
                                    <div class="flex-grow">
                                        <div class="font-semibold text-gray-900 mb-2">
                                            {{ userGroup.user.userIdentifier }}
                                        </div>
                                        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold
                                        {% if userGroup.role == 'ROLE_ADMIN' %}
                                            bg-yellow-100 text-yellow-800
                                        {% elseif userGroup.role == 'ROLE_MODERATOR' %}
                                            bg-orange-100 text-orange-800
                                        {% else %}
                                            bg-blue-100 text-blue-800
                                        {% endif %}
                                    ">
                                        {{ userGroup.role }}
                                    </span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="bg-gray-50 rounded-lg p-8 text-center">
                            <p class="text-gray-600 mb-4">Aucun membre pour le moment.</p>
                            <a href="{{ path('app_group_invite', {'id': group.id}) }}" class="inline-block px-6 py-2 bg-teal-600 hover:bg-teal-700 text-white font-semibold rounded-lg transition-colors duration-200">
                                Inviter des membres
                            </a>
                        </div>
                    {% endif %}
                </div>

                <div class="bg-white rounded-lg shadow-md p-6 sm:p-8 mb-6 border border-gray-200">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b border-gray-200 flex items-center justify-between">
                        📸 Galerie
                        <span class="ml-2 px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-lg font-semibold">{{ group.photos|length }}</span>
                    </h2>

                    {% if group.photos|length > 0 %}
                        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                            {% for photo in group.photos %}
                                <div onclick="openPhoto('{{ photo.url }}')" class="relative rounded-lg overflow-hidden aspect-square cursor-pointer hover:shadow-lg transition-shadow duration-200 group">
                                    <img src="{{ photo.url }}" alt="Photo {{ loop.index }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200">
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200 flex flex-col justify-end p-3">
                                        <div class="text-white text-xs">Par {{ photo.userId.userIdentifier }}</div>
                                        <div class="text-white text-xs">{{ photo.createdAt|date('d/m/Y') }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="bg-gray-50 rounded-lg p-8 text-center">
                            <p class="text-gray-600 mb-4">Aucune photo n'a encore été ajoutée.</p>
                        </div>
                    {% endif %}
                </div>

            {% endif %}

        </div>

        <script>
            function copyToken() {
                const tokenText = document.getElementById('groupToken').textContent;

                navigator.clipboard.writeText(tokenText).then(() => {
                    const button = event.target;
                    const originalText = button.textContent;

                    button.textContent = '✅ Copié !';
                    button.classList.remove('bg-teal-600', 'hover:bg-teal-700');
                    button.classList.add('bg-green-600');

                    setTimeout(() => {
                        button.textContent = originalText;
                        button.classList.remove('bg-green-600');
                        button.classList.add('bg-teal-600', 'hover:bg-teal-700');
                    }, 2000);
                }).catch(err => {
                    alert('Erreur lors de la copie : ' + err);
                });
            }

            function openPhoto(url) {
                window.open(url, '_blank');
            }
        </script>
    </div>
{% endblock %}
