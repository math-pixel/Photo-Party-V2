{% extends 'base.html.twig' %}

{% block title %}Capturer une photo{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-50 py-8">
        <div class="max-w-2xl mx-auto px-4">
            <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200">

                <!-- Tabs pour webcam/upload -->
                <div class="flex gap-4 mb-6 border-b border-gray-200">
                    <button onclick="switchTab('webcam')" id="webcam-tab" class="pb-3 px-4 font-semibold text-teal-600 border-b-2 border-teal-600 cursor-pointer">
                        📷 Webcam
                    </button>
                    <button onclick="switchTab('upload')" id="upload-tab" class="pb-3 px-4 font-semibold text-gray-600 hover:text-gray-900 cursor-pointer">
                        📁 Télécharger
                    </button>
                </div>

                {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

                <div class="hidden">
                    {{ form_widget(form.imageFile) }}
                </div>


                <!-- Webcam Tab -->
                <div id="webcam-content" class="space-y-4">
                    <video id="webcam" class="w-full bg-black rounded-lg mb-4" autoplay playsinline></video>

                    <div id="webcam-preview" class="hidden">
                        <img id="captured-image" src="/placeholder.svg" alt="Photo capturée" class="w-full rounded-lg mb-4 border border-gray-200">
                    </div>

                    <canvas id="canvas" class="hidden"></canvas>

                    <!-- Added hidden wrapper for webcam and capture button -->
                    <div id="webcam-controls" class="flex gap-4">


                        <button type="button" onclick="startWebcam()" id="start-webcam-btn" class="flex-1 px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white font-semibold rounded-lg transition">
                            Démarrer webcam
                        </button>
                        <button type="button" onclick="capturePhoto()" id="capture-btn" class="flex-1 px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white font-semibold rounded-lg transition hidden">
                            Capturer
                        </button>
                    </div>
                </div>

                <!-- Upload Tab -->
                <div id="upload-content" class="hidden space-y-4">
                    <input type="file" id="file-input" accept="image/*" onchange="handleFileUpload(event)" class="w-full px-4 py-2 border border-gray-300 rounded-lg cursor-pointer">

                    <div id="upload-preview" class="hidden">
                        <img id="uploaded-image" src="/placeholder.svg" alt="Photo téléchargée" class="w-full rounded-lg mb-4 border border-gray-200">
                    </div>
                </div>

                <!-- Preview et Actions -->
                <div id="preview-section" class="hidden mt-6 pt-6 border-t border-gray-200">
                    <p class="text-gray-700 font-semibold mb-4">Photo sélectionnée</p>

                    <div class="flex gap-3">
                        <button type="button" onclick="cancelPhoto()" class="flex-1 px-4 py-3 bg-gray-300 hover:bg-gray-400 text-gray-900 font-semibold rounded-lg transition">
                            ❌ Annuler
                        </button>
                        <button type="submit" id="send-btn" class="flex-1 px-4 py-3 bg-teal-600 hover:bg-teal-700 text-white font-semibold rounded-lg transition">
                            ✅ Envoyer
                        </button>
                    </div>
                </div>
                {{ form_end(form) }}

                <div class="pt-8">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success">
                            {{ message }}
                        </div>
                    {% endfor %}
                </div>

                <!-- Status Feedback -->
                <div id="status-message" class="hidden mt-6 p-4 rounded-lg text-center font-semibold">
                </div>

            </div>

            <h1 class="text-3xl font-bold text-gray-900 mb-8 text-center">Capturer ou télécharger une photo</h1>

        </div>
    </div>

    <script>
        let currentPhoto = null;
        let webcamStream = null;
        const groupId = new URLSearchParams(window.location.search).get('groupId');

        // DOM Elements
        const webcamContent = document.getElementById('webcam-content');
        const uploadContent = document.getElementById('upload-content');
        const webcamTab = document.getElementById('webcam-tab');
        const uploadTab = document.getElementById('upload-tab');
        const webcamVideo = document.getElementById('webcam');
        const canvas = document.getElementById('canvas');
        const capturedImage = document.getElementById('captured-image');
        const uploadedImage = document.getElementById('uploaded-image');
        const webcamPreview = document.getElementById('webcam-preview');
        const uploadPreview = document.getElementById('upload-preview');
        const previewSection = document.getElementById('preview-section');
        const fileInput = document.getElementById('file-input');
        const statusMessage = document.getElementById('status-message');
        const startWebcamBtn = document.getElementById('start-webcam-btn');
        const captureBtn = document.getElementById('capture-btn');
        const sendBtn = document.getElementById('send-btn');
        const webcamControls = document.getElementById('webcam-controls');

        function switchTab(tab) {
            webcamContent.classList.toggle('hidden', tab !== 'webcam');
            uploadContent.classList.toggle('hidden', tab !== 'upload');

            // Remove all active classes from both tabs
            webcamTab.classList.remove('border-b-2', 'border-teal-600', 'text-teal-600');
            uploadTab.classList.remove('border-b-2', 'border-teal-600', 'text-teal-600');

            // Add active classes to the selected tab
            if (tab === 'webcam') {
                webcamTab.classList.add('border-b-2', 'border-teal-600', 'text-teal-600');
                uploadTab.classList.add('text-gray-600');
            } else {
                uploadTab.classList.add('border-b-2', 'border-teal-600', 'text-teal-600');
                webcamTab.classList.add('text-gray-600');
            }
        }

        function startWebcam() {
            navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } })
                .then(stream => {
                    webcamStream = stream;
                    webcamVideo.srcObject = stream;
                    startWebcamBtn.classList.add('hidden');
                    captureBtn.classList.remove('hidden');
                })
                .catch(err => showStatus('Erreur d\'accès à la webcam: ' + err.message, 'error'));
        }

        function capturePhoto() {
            const ctx = canvas.getContext('2d');

            canvas.width = webcamVideo.videoWidth;
            canvas.height = webcamVideo.videoHeight;
            ctx.drawImage(webcamVideo, 0, 0);

            canvas.toBlob((blob) => {
                // Créer un objet File à partir du blob
                const file = new File([blob], 'webcam-photo.jpg', {
                    type: 'image/jpeg',
                    lastModified: new Date().getTime()
                });

                console.log('Photo capturée:', file.name, file.size, 'bytes');

                attachFileToForm(file);

                // Prévisualisation
                currentPhoto = URL.createObjectURL(blob);
                showPhotoPreview(currentPhoto);

                webcamVideo.classList.add('hidden');
                webcamControls.classList.add('hidden');
                showStatus('Photo capturée', 'success');

            }, 'image/jpeg', 0.95); // Type MIME + qualité 95%
        }

        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    currentPhoto = e.target.result;
                    showPhotoPreview(currentPhoto);
                    showStatus('Photo sélectionnée', 'success');
                };
                reader.readAsDataURL(file);

                attachFileToForm(file);
            }
        }

        function showPhotoPreview(photoData) {
            capturedImage.src = photoData;
            uploadedImage.src = photoData;
            webcamPreview.classList.remove('hidden');
            uploadPreview.classList.remove('hidden');
            previewSection.classList.remove('hidden');
        }

        function cancelPhoto() {
            currentPhoto = null;
            webcamPreview.classList.add('hidden');
            uploadPreview.classList.add('hidden');
            previewSection.classList.add('hidden');
            fileInput.value = '';

            if (webcamStream) {
                webcamStream.getTracks().forEach(track => track.stop());
                webcamStream = null;
            }
            webcamVideo.srcObject = null;
            webcamVideo.classList.remove('hidden');
            webcamControls.classList.remove('hidden');
            startWebcamBtn.classList.remove('hidden');
            captureBtn.classList.add('hidden');
            showStatus('', '');

            removeAttachFileToForm()
        }

        function attachFileToForm(file) {
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);

            const input = document.getElementById('photo_imageFile_file');
            console.log(input.files)
            input.files = dataTransfer.files;
            console.log(input.files)
        }

        function removeAttachFileToForm() {
            console.log('=== DÉBUT removeAttachFileToForm ===');

            // 1. Trouver l'input Symfony
            const input = document.getElementById('photo_imageFile_file');

            if (!input) {
                console.error('❌ Input photo_imageFile_file NOT FOUND !');
                return false;
            }

            console.log('📁 AVANT suppression:', input.files.length, 'fichier(s)');

            // 2. Réinitialiser l'input (vider les fichiers)
            input.value = ''; // ⭐ Cette ligne vide l'input

            console.log('📁 APRÈS suppression:', input.files.length, 'fichier(s)');

            // 3. Vérification
            if (input.files.length === 0) {
                console.log('✅ Fichier supprimé avec succès');
            } else {
                console.error('❌ Le fichier n\'a pas été supprimé !');
            }

            console.log('=== FIN removeAttachFileToForm ===');

            return input.files.length === 0;
        }

        function showStatus(message, type) {
            statusMessage.textContent = message;
            statusMessage.classList.remove('hidden', 'bg-green-100 text-green-800', 'bg-red-100 text-red-800', 'bg-blue-100 text-blue-800');

            if (type === 'success') {
                statusMessage.classList.add('bg-green-100', 'text-green-800');
            } else if (type === 'error') {
                statusMessage.classList.add('bg-red-100', 'text-red-800');
            } else if (type === 'loading') {
                statusMessage.classList.add('bg-blue-100', 'text-blue-800');
            } else {
                statusMessage.classList.add('hidden');
            }
        }
    </script>
{% endblock %}
