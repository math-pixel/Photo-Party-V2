{% extends 'base.html.twig' %}

{% block title %}Accueil - PhotoParty{% endblock %}

{% block body %}
    <main class="relative min-h-screen bg-slate-50 font-sans selection:bg-party-purple selection:text-white overflow-x-hidden">

        {# --- DÉCORATION D'ARRIÈRE-PLAN (Subtile) --- #}
        <div class="absolute top-0 left-0 w-[500px] h-[500px] bg-party-yellow/10 rounded-full blur-3xl pointer-events-none -translate-x-1/2 -translate-y-1/2"></div>
        <div class="absolute top-20 right-0 w-[400px] h-[400px] bg-party-purple/5 rounded-full blur-3xl pointer-events-none translate-x-1/3"></div>

        <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

            {# --- HEADER DE SECTION (Hero) --- #}
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-8 mb-12">

                <!-- Salutations -->
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-slate-100 shadow-sm text-xs font-bold uppercase tracking-wide text-slate-500 mb-3">
                        👋 Tableau de bord
                    </div>
                    <h1 class="text-4xl md:text-5xl font-display font-bold text-slate-900 leading-tight">
                        Bienvenue, <br>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-party-blue to-party-purple">
                            {{ app.user.firstname|default('Organisateur') }} {{ app.user.lastname|default('') }}
                        </span>
                    </h1>
                    <p class="text-slate-500 text-lg mt-4 max-w-lg">
                        Gérez vos événements, lancez des projections et partagez vos meilleurs moments.
                    </p>
                </div>

                <!-- Action Principale : Créer un groupe -->
                <div class="flex-shrink-0">
                    <a href="{{ path('app_group_create') }}" class="btn btn-primary px-8 py-4 text-lg shadow-xl shadow-party-purple/20">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 mr-2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        Créer un groupe
                    </a>
                </div>
            </div>

            {# --- LISTE DES GROUPES --- #}
            <section>
                <div class="flex items-center justify-between mb-8">
                    <h2 class="text-2xl font-display font-bold text-slate-900 flex items-center gap-3">
                        Mes événements
                        <span class="bg-slate-200 text-slate-600 text-sm font-bold px-2.5 py-0.5 rounded-full">
                            {{ groups|length }}
                        </span>
                    </h2>
                </div>

                {% if groups is not empty %}
                    <div class="space-y-6">
                        {% for group in groups %}
                            {# On inclut le composant "Card" qu'on a créé juste avant #}
                            {% include 'components/group-bar.html.twig' with { group: group  } %}
                        {% endfor %}
                    </div>

                    {# Petit footer de liste #}
                    <div class="mt-12 text-center">
                        <p class="text-slate-400 text-sm">Vous avez atteint la fin de la liste 🎉</p>
                    </div>

                {% else %}

                    {# --- EMPTY STATE (Aucun groupe) --- #}
                    <div class="bg-white rounded-[32px] border border-slate-100 shadow-xl shadow-slate-200/40 p-12 text-center max-w-2xl mx-auto">

                        <!-- Illustration Icon -->
                        <div class="w-24 h-24 mx-auto bg-slate-50 rounded-full flex items-center justify-center mb-6 relative">
                            <div class="absolute inset-0 bg-party-yellow/20 rounded-full animate-pulse"></div>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-party-orange">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H4.5a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                            </svg>
                        </div>

                        <h3 class="text-2xl font-display font-bold text-slate-900 mb-3">
                            C'est un peu calme ici...
                        </h3>
                        <p class="text-slate-500 mb-8 max-w-md mx-auto">
                            Vous ne participez à aucun événement pour le moment. Créez votre premier groupe pour commencer à collecter des photos !
                        </p>

                        <a href="{{ path('app_group_create') }}" class="btn btn-primary px-6 py-3">
                            Commencer l'aventure 🚀
                        </a>
                    </div>
                {% endif %}
            </section>

        </div>
    </main>
{% endblock %}
