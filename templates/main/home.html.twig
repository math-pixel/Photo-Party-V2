{% extends 'base.html.twig' %}

{% block title %}Accueil - Community Photos{% endblock %}

{% block body %}
    <main class="min-h-screen bg-gray-50">
        <!-- Hero Section -->
        <section class="bg-white border-b border-gray-200 py-12 px-4 sm:px-6 lg:px-8">
            <div class="max-w-7xl mx-auto">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
                    <!-- User Greeting -->
                    <div>
                        <h1 class="text-3xl font-bold text-gray-900">
                            Bienvenue, <span class="text-teal-600">{{ app.user.firstname }} {{ app.user.lastname }}</span>
                        </h1>
                        <p class="text-gray-600 mt-2">Gérez vos groupes et partagez vos photos</p>
                    </div>

                    <!-- Create Group CTA -->
                    <a href="{{ path('app_group_create') }}" class="btn inline-flex items-center justify-center px-6 py-3 bg-teal-600 text-white font-medium rounded-lg hover:bg-teal-700 transition-colors duration-200 whitespace-nowrap">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Créer un groupe
                    </a>
                </div>
            </div>
        </section>

        <!-- Groups List Section -->
        <section class="py-12 px-4 sm:px-6 lg:px-8">
            <div class="max-w-7xl mx-auto">
                {% if groups is not empty %}
                    <h2 class="text-2xl font-bold text-gray-900 mb-8">Mes groupes</h2>
                    <div class="space-y-2">
                        {% for group in groups %}
                            {% include 'components/group-bar.html.twig' with { group: group } %}
                        {% endfor %}
                    </div>
                {% else %}
                    <!-- Empty State -->
                    <div class="bg-white rounded-lg border border-gray-200 p-12 text-center">
                        <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                        </svg>
                        <h3 class="text-xl font-semibold text-gray-900 mb-2">Aucun groupe pour le moment</h3>
                        <p class="text-gray-600 mb-6">Créez votre premier groupe pour commencer à partager des photos avec votre communauté.</p>
                        <a href="{{ path('app_group_create') }}" class="inline-flex items-center px-6 py-3 bg-teal-600 text-white font-medium rounded-lg hover:bg-teal-700 transition-colors duration-200">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            Créer mon premier groupe
                        </a>
                    </div>
                {% endif %}
            </div>
        </section>
    </main>
{% endblock %}
