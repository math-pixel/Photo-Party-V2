{% extends 'base.html.twig' %}

{% block title %}Bienvenue !{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* On garde la même base stylistique festive */
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap');

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(-45deg, #f4d03f, #16a085, #f1c40f, #2ecc71);
            background-size: 400% 400%;
            animation: gradient 15s ease infinite;
            color: #fff;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
        }

        @keyframes gradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* La carte de bienvenue */
        .welcome-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 3em;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            width: 100%;
            max-width: 600px;
            text-align: center;
            z-index: 10;
        }

        .welcome-card h1 {
            font-size: 2.8em;
            margin-bottom: 0.5em;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }

        .welcome-card .user-name {
            color: #f1c40f; /* Couleur dorée pour mettre en avant le nom */
            font-weight: bold;
        }

        .welcome-card p {
            font-size: 1.2em;
            line-height: 1.6;
            margin-bottom: 2em;
        }

        /* Bouton principal (Call To Action) */
        .btn-cta {
            display: inline-block;
            padding: 15px 30px;
            border: none;
            border-radius: 50px; /* Bouton arrondi */
            background: linear-gradient(90deg, #16a085 0%, #f4d03f 100%);
            color: white;
            font-size: 1.2em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            text-transform: uppercase;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            margin-bottom: 1.5em;
        }

        .btn-cta:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        }

        /* Lien de déconnexion */
        .logout-link {
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            font-weight: bold;
            transition: color 0.3s ease;
        }

        .logout-link:hover {
            color: #fff;
            text-decoration: underline;
        }

        /* Animation des confettis */
        .confetti-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            z-index: 1;
        }
        .confetti { position: absolute; width: 10px; height: 10px; background-color: #f0f; animation: fall linear infinite; }
        @keyframes fall { to { transform: translateY(110vh) rotateZ(720deg); } }

        {% for i in 1..30 %}
        .confetti:nth-child({{ i }}) {
            left: {{ random(0, 100) }}%;
            background-color: {{ random(['#ffc300', '#ff5733', '#c70039', '#1abc9c', '#3498db', '#9b59b6']) }};
            width: {{ random(8, 20) }}px;
            height: {{ random(5, 10) }}px;
            animation-duration: {{ random(4, 12) }}s;
            animation-delay: -{{ random(0, 10) }}s;
            opacity: {{ random(6, 10) / 10 }};
            transform: rotateZ({{ random(0, 360) }}deg);
        }
        {% endfor %}
    </style>
{% endblock %}

{% block body %}
    <div class="confetti-container">
        {% for i in 1..30 %} {# Plus de confettis pour la célébration ! #}
            <div class="confetti"></div>
        {% endfor %}
    </div>

    <div class="welcome-card">
        <h1>
            Bienvenue, <br>
            {# On utilise l'identifiant de l'utilisateur. Si vous avez un champ 'firstName', utilisez app.user.firstName #}
        </h1>

        <p>
            Que la fête commence ! Vous êtes bien connecté(e).<br>
            Explorez tout ce que notre site a à vous offrir.
        </p>

        <div>
            <a href="{{ path('app_logout') }}" class="logout-link">Se déconnecter</a>
        </div>
    </div>
{% endblock %}
