{% extends 'base.html.twig' %}

{% block title %}Inscription - Photo Gallery{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-md">
            <!-- Logo/Header -->
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Community Photos</h1>
                <p class="text-gray-600">Créez votre compte</p>
            </div>

            <!-- Form Card -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 space-y-6">

                {% if form_errors(registrationForm) %}
                    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
                        <p class="font-semibold">Erreurs d'inscription :</p>
                        {{ form_errors(registrationForm) }}
                    </div>
                {% endif %}

                {{ form_start(registrationForm, {'attr': {'class': 'space-y-5'}}) }}

                <!-- Email Field -->
                <div>
                    {{ form_label(registrationForm.email, 'Adresse email', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 mb-2'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent outline-none transition', 'placeholder': 'vous@exemple.com'}}) }}
                    {% if form_errors(registrationForm.email) %}
                        <p class="mt-1 text-red-600 text-sm">{{ form_errors(registrationForm.email) }}</p>
                    {% endif %}
                </div>

                <!-- First Name -->
{#                <div>#}
{#                    {{ form_label(registrationForm.firstName, 'Prénom', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 mb-2'}}) }}#}
{#                    {{ form_widget(registrationForm.firstName, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent outline-none transition', 'placeholder': 'Jean'}}) }}#}
{#                </div>#}

                <!-- Last Name -->
{#                <div>#}
{#                    {{ form_label(registrationForm.lastName, 'Nom', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 mb-2'}}) }}#}
{#                    {{ form_widget(registrationForm.lastName, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent outline-none transition', 'placeholder': 'Dupont'}}) }}#}
{#                </div>#}

                <!-- Password Field -->
                <div>
                    {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 mb-2'}}) }}
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent outline-none transition', 'placeholder': '••••••••'}}) }}
                    <p class="mt-1 text-gray-500 text-xs">Minimum 8 caractères</p>
                </div>

                <!-- Confirm Password Field -->
{#                <div>#}
{#                    {{ form_label(registrationForm.plainPassword, 'Confirmer le mot de passe', {'label_attr': {'class': 'block text-sm font-medium text-gray-900 mb-2'}}) }}#}
{#                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent outline-none transition', 'placeholder': '••••••••'}}) }}#}
{#                </div>#}

                <!-- Submit Button -->
                <button
                    type="submit"
                    class="w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-200 ease-in-out"
                >
                    S'inscrire
                </button>

                {{ form_end(registrationForm) }}

                <!-- Divider -->
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-300"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-2 bg-white text-gray-500">ou</span>
                    </div>
                </div>

                <!-- Login Link -->
                <p class="text-center text-gray-600 text-sm">
                    Déjà inscrit ?
                    <a href="{{ path('app_login') }}" class="text-teal-600 hover:text-teal-700 font-semibold">
                        Se connecter
                    </a>
                </p>
            </div>

            <!-- Footer Link -->
            <p class="text-center text-gray-500 text-xs mt-6">
                <a href="/" class="hover:text-gray-700">← Retour à l'accueil</a>
            </p>
        </div>
    </div>
{% endblock %}
