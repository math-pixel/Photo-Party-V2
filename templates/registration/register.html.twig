{% extends 'base.html.twig' %}

{% block title %}Inscription - PhotoParty{% endblock %}

{% block body %}
    <div class="relative min-h-screen bg-slate-50 flex items-center justify-center px-4 py-12 overflow-hidden font-sans selection:bg-party-purple selection:text-white">

        {# --- DECORATION D'ARRIÈRE-PLAN (Blobs) --- #}
        {# On change légèrement la position/couleur par rapport au Login pour varier #}
        <div class="absolute top-0 right-0 -translate-y-1/4 translate-x-1/4 w-[600px] h-[600px] bg-party-pink/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 translate-y-1/4 -translate-x-1/4 w-[500px] h-[500px] bg-party-purple/5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 w-full max-w-md">

            {# --- HEADER / LOGO --- #}
            <div class="text-center mb-10">
                <a href="/" class="inline-block mb-6 group hover:opacity-90 transition-opacity">
                    <div class="text-4xl font-display font-bold text-slate-900 tracking-tight">
                        Photo<span class="text-transparent bg-clip-text bg-gradient-to-r from-party-pink to-party-purple">Party</span>
                        <span class="text-party-yellow">.</span>
                    </div>
                </a>
                <h2 class="text-xl font-bold text-slate-900">Bienvenue à bord !</h2>
                <p class="text-slate-500 mt-2 text-sm">Créez votre compte pour organiser votre premier événement.</p>
            </div>

            {# --- CARTE FORMULAIRE --- #}
            <div class="bg-white rounded-[32px] shadow-xl shadow-slate-200/60 p-8 md:p-10 border border-slate-100">

                {# Affichage des erreurs globales #}
                {% if form_errors(registrationForm) %}
                    <div class="mb-6 bg-red-50 border border-red-100 text-red-600 px-4 py-3 rounded-2xl text-sm">
                        <div class="flex items-center gap-2 font-bold mb-1">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" /></svg>
                            Oups, une erreur :
                        </div>
                        {{ form_errors(registrationForm) }}
                    </div>
                {% endif %}

                {{ form_start(registrationForm, {'attr': {'class': 'space-y-5'}}) }}

                <!-- Email Field -->
                <div>
                    {{ form_label(registrationForm.email, 'Adresse email', {'label_attr': {'class': 'block text-sm font-bold text-slate-700 mb-2 ml-1'}}) }}

                    {# J'applique les styles manuellement ici pour être sûr, mais ta classe .input globale marcherait aussi #}
                    {{ form_widget(registrationForm.email, {
                        'attr': {
                            'class': 'w-full px-4 py-3 bg-slate-50 border border-slate-200 text-slate-900 rounded-xl focus:ring-2 focus:ring-party-purple focus:border-transparent outline-none transition-all placeholder:text-slate-400',
                            'placeholder': 'vous@exemple.com'
                        }
                    }) }}

                    {% if form_errors(registrationForm.email) %}
                        <div class="mt-2 text-party-pink text-sm font-medium ml-1">
                            {{ form_errors(registrationForm.email) }}
                        </div>
                    {% endif %}
                </div>

                <!-- First Name & Last Name (Commentés mais stylisés pour le futur) -->
                {#
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        {{ form_label(registrationForm.firstName, 'Prénom', {'label_attr': {'class': 'block text-sm font-bold text-slate-700 mb-2 ml-1'}}) }}
                        {{ form_widget(registrationForm.firstName, {'attr': {'class': 'w-full px-4 py-3 bg-slate-50 border border-slate-200 text-slate-900 rounded-xl focus:ring-2 focus:ring-party-purple outline-none transition-all', 'placeholder': 'Jean'}}) }}
                    </div>
                    <div>
                        {{ form_label(registrationForm.lastName, 'Nom', {'label_attr': {'class': 'block text-sm font-bold text-slate-700 mb-2 ml-1'}}) }}
                        {{ form_widget(registrationForm.lastName, {'attr': {'class': 'w-full px-4 py-3 bg-slate-50 border border-slate-200 text-slate-900 rounded-xl focus:ring-2 focus:ring-party-purple outline-none transition-all', 'placeholder': 'Dupont'}}) }}
                    </div>
                </div>
                #}

                <!-- Password Field -->
                <div>
                    {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'block text-sm font-bold text-slate-700 mb-2 ml-1'}}) }}

                    {{ form_widget(registrationForm.plainPassword, {
                        'attr': {
                            'class': 'w-full px-4 py-3 bg-slate-50 border border-slate-200 text-slate-900 rounded-xl focus:ring-2 focus:ring-party-purple focus:border-transparent outline-none transition-all placeholder:text-slate-400',
                            'placeholder': '••••••••'
                        }
                    }) }}

                    <p class="mt-2 text-slate-400 text-xs ml-1">
                        Minimum 6 caractères
                    </p>
                    {% if form_errors(registrationForm.plainPassword) %}
                        <div class="mt-2 text-party-pink text-sm font-medium ml-1">
                            {{ form_errors(registrationForm.plainPassword) }}
                        </div>
                    {% endif %}
                </div>

                <!-- Agree Terms Field -->
                <div class="flex items-start gap-3 mt-4 ml-1">
                    {# 1. Le Widget (La case à cocher) #}
                    <div class="flex h-6 items-center">
                        {{ form_widget(registrationForm.agreeTerms, {
                            'attr': {
                                'class': 'w-5 h-5 border-slate-300 rounded text-party-purple focus:ring-party-purple cursor-pointer accent-party-purple'
                            }
                        }) }}
                    </div>

                    {# 2. Le Label (Le texte) #}
                    <div class="text-sm leading-6">
                        <label for="{{ registrationForm.agreeTerms.vars.id }}" class="font-medium text-slate-600 select-none cursor-pointer">
                            Agree Terms
                        </label>

                        {# 3. Les erreurs spécifiques à ce champ #}
                        {% if form_errors(registrationForm.agreeTerms) %}
                            <div class="text-party-pink text-xs font-bold mt-1">
                                {{ form_errors(registrationForm.agreeTerms) }}
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Submit Button utilisant ta classe .btn-primary -->
                <button type="submit" class="btn btn-primary w-full mt-4">
                    Créer mon compte
                </button>

                {{ form_end(registrationForm) }}

                <!-- Divider -->
                <div class="relative my-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-slate-100"></div>
                    </div>
                    <div class="relative flex justify-center text-xs uppercase font-bold tracking-wider">
                        <span class="px-4 bg-white text-slate-400">Déjà membre ?</span>
                    </div>
                </div>

                <!-- Login Link -->
                <div class="text-center">
                    <a href="{{ path('app_login') }}" class="text-party-purple hover:text-party-blue font-bold transition-colors">
                        Se connecter à mon compte
                    </a>
                </div>
            </div>

            <!-- Footer Link -->
            <p class="text-center mt-8">
                <a href="/" class="inline-flex items-center text-slate-400 hover:text-slate-600 text-sm font-medium transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                    </svg>
                    Retour à l'accueil
                </a>
            </p>
        </div>
    </div>
{% endblock %}
