{% extends "base.html.twig" %}

{% block title %}Projection en direct{% endblock %}

{% block content %}
    <div class="fixed inset-0 bg-black flex flex-col w-full h-full">
        <!-- Simplified to full-screen black background with title and centered gallery -->

        <!-- Title -->
        <div class="pt-8 px-6 text-center">
            <h1 class="text-4xl font-bold text-white">Projection en direct</h1>
        </div>

        <!-- Gallery Container -->
        <div class="flex-1 flex items-center justify-center overflow-auto px-6 py-8">
            <div id="gallery" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl">
                <!-- Images ajoutées en temps réel via JavaScript -->
                <div class="text-center text-gray-500 col-span-full py-12">
                    <p>En attente de photos...</p>
                </div>
            </div>
        </div>

        <!-- Logos en bas à droite -->
        <!-- Added logos positioned at bottom-right, max 5% screen width -->
        <div class="fixed bottom-4 right-4 flex flex-col items-end gap-2 bg-blue-100">
            <!-- Logo 2 (au-dessus) -->
            <img src="{{ [app.request.getBaseURL(), default_path_image_group, groupParameter.getImage2Name]|join }}" alt="" class="max-w-[5vw] h-auto">

            <!-- Logo 1 (en bas) -->
            <img src="{{ [app.request.getBaseURL(), default_path_image_group, groupParameter.getImage1Name]|join }}" alt="" class="max-w-[5vw] h-auto">
        </div>
    </div>

    <script>
        const galleryDOM = document.getElementById('gallery');
        const emptyState = galleryDOM.querySelector('.text-center');

        // Configuration
        {#'{{ mercure_url|default("http://localhost:1337/.well-known/mercure") }}'#}
        const mercureUrl =  '{{ mercure_url }}';
        {#'{{ mercure_topic|default("https://example.com/photos/new") }}'#}
        const mercureTopic = '{{ mercure_topic }}'; // topic = groupId
        const defaultPathImage = '{{ default_path_image }}'
        const baseUrl = window.location.origin //"http://127.0.0.1:8000/"

        let eventSource = null;
        let pathImages = []

        // 🔌 Fonction de connexion à Mercure
        function connectMercure() {
            // Construire l'URL avec le topic
            const url = new URL(mercureUrl);
            url.searchParams.append('topic', mercureTopic);
            console.warn(url)
            console.log('🔌 Connexion à Mercure:', url.toString());

            // Créer l'EventSource
            eventSource = new EventSource(url.toString());

            // ✅ Connexion établie
            eventSource.addEventListener('open', () => {
                console.log('✅ Connecté à Mercure');
                console.log('✅ Ecoute sur le topic :' + mercureTopic);
            });

            // 📨 Message reçu
            eventSource.addEventListener('message', (event) => {
                console.log('📨 Message reçu:', event.data);

                try {
                    const data = JSON.parse(event.data);
                    addPhotoToGallery(data);
                } catch (error) {
                    console.error('❌ Erreur parsing JSON:', error);
                }
            });

            // ❌ Erreur de connexion
            eventSource.addEventListener('error', (error) => {
                console.error('❌ Erreur Mercure:', error);

                // Fermer la connexion actuelle
                if (eventSource) {
                    eventSource.close();
                    eventSource = null;
                }

                // Reconnecter après 5 secondes
                console.log('🔄 Reconnexion dans 5s...');
                setTimeout(connectMercure, 5000);
            });
        }

        // 🖼️ Ajouter une photo à la galerie
        function addPhotoToGallery(data) {

            let path = baseUrl + defaultPathImage + data.url;
            pathImages.push(path);
            console.log(pathImages)

        }

        function displayImage(path){

            // Supprimer le message "En attente de photos..." si présent
            if (emptyState && emptyState.parentElement === galleryDOM) {
                emptyState.remove();
            }

            // Créer l'élément image
            const imgContainer = document.createElement('div');
            imgContainer.className = 'overflow-hidden rounded-lg shadow-lg';

            const img = document.createElement('img');
            img.src =  path;
            img.alt = 'Nouvelle photo';
            img.className = 'w-full h-64 object-cover';

            imgContainer.appendChild(img);

            galleryDOM.innerHTML = '';
            galleryDOM.appendChild(imgContainer);
        }

        // 🧹 Nettoyer la connexion quand on quitte la page
        window.addEventListener('beforeunload', () => {
            if (eventSource) {
                console.log('🔌 Fermeture de la connexion Mercure');
                eventSource.close();
            }
        });

        // 📊 Debug : Afficher les photos initiales (si besoin)
        {% if photos is defined %}
            // Get existing photo
            var photosRawData = {{ photos|json_encode()|raw }};
            var photos = JSON.parse(photosRawData)
            console.log("photos : ", photos)
            console.log(photos[0].id)
            photos.forEach( (photoUrl) =>
                addPhotoToGallery({url: photoUrl})
            )
        {% endif %}

        function loopImage(){
            let i = 0
            setInterval(() => {
                if (pathImages[i] != null ){
                    console.log(pathImages[i])
                    displayImage(pathImages[i])
                }

                i+=1
                if (i >= pathImages.length){
                    i = 0
                }
            }, 1000)
        }


        // 🚀 Lancer la connexion au chargement
        connectMercure();

        // start loop
        loopImage()
    </script>
{% endblock %}
