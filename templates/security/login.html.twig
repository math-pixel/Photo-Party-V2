{% extends 'base.html.twig' %}

{% block title %}Connexion - PhotoParty{% endblock %}

{% block body %}
    <div class="relative min-h-screen bg-slate-50 flex items-center justify-center px-4 py-12 overflow-hidden font-sans selection:bg-party-purple selection:text-white">

        {# --- ARRIÈRE-PLAN DÉCORATIF (Blobs flous) --- #}
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-party-purple/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 right-0 translate-x-1/3 translate-y-1/3 w-[500px] h-[500px] bg-party-blue/5 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 w-full max-w-md">

            {# --- LOGO & TITRE --- #}
            <div class="text-center mb-10">
                <a href="/" class="inline-block mb-6 group">
                    <div class="text-4xl font-display font-bold text-slate-900 tracking-tight">
                        Photo<span class="text-transparent bg-clip-text bg-gradient-to-r from-party-pink to-party-purple">Party</span>
                        <span class="text-party-yellow">.</span>
                    </div>
                </a>
                <h2 class="text-xl font-bold text-slate-900">Heureux de vous revoir !</h2>
                <p class="text-slate-500 mt-2 text-sm">Entrez vos identifiants pour gérer vos événements.</p>
            </div>

            {# --- CARTE DU FORMULAIRE --- #}
            <div class="bg-white rounded-[32px] shadow-xl shadow-slate-200/60 p-8 md:p-10 border border-slate-100">

                {% if error %}
                    <div class="mb-6 bg-red-50 border border-red-100 text-red-600 px-4 py-3 rounded-2xl text-sm flex items-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 flex-shrink-0">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                        </svg>
                        {{ error.messageKey | trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" class="space-y-6">

                    <!-- Email Field -->
                    <div>
                        <label for="inputEmail" class="block text-sm font-bold text-slate-700 mb-2 ml-1">
                            Adresse email
                        </label>
                        <input
                            type="email"
                            id="inputEmail"
                            name="email"
                            value="{{ last_username }}"
                            required
                            autofocus
                            class="w-full px-5 py-3 bg-slate-50 border border-slate-200 text-slate-900 rounded-xl focus:ring-2 focus:ring-party-purple focus:border-transparent outline-none transition-all placeholder:text-slate-400"
                            placeholder="vous@exemple.com"
                        >
                    </div>

                    <!-- Password Field -->
                    <div>
                        <div class="flex justify-between items-center mb-2 ml-1">
                            <label for="inputPassword" class="block text-sm font-bold text-slate-700">
                                Mot de passe
                            </label>
                            <a href="#" class="text-xs font-semibold text-party-purple hover:text-party-pink transition-colors">
                                Mot de passe oublié ?
                            </a>
                        </div>
                        <input
                            type="password"
                            id="inputPassword"
                            name="password"
                            required
                            class="w-full px-5 py-3 bg-slate-50 border border-slate-200 text-slate-900 rounded-xl focus:ring-2 focus:ring-party-purple focus:border-transparent outline-none transition-all placeholder:text-slate-400"
                            placeholder="••••••••"
                        >
                    </div>

                    <!-- Remember Me -->
                    <div class="flex items-center ml-1">
                        <input
                            type="checkbox"
                            id="remember"
                            name="_remember_me"
                            class="w-4 h-4 text-party-purple border-slate-300 rounded focus:ring-party-purple cursor-pointer accent-party-purple"
                        >
                        <label for="remember" class="ml-2 text-sm font-medium text-slate-600 cursor-pointer select-none">
                            Se souvenir de moi
                        </label>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        class="btn btn-primary px-8 py-4 rounded-[20px] text-lg"
                    >
                        Se connecter
                    </button>
                </form>

                <!-- Divider -->
                <div class="relative my-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-slate-100"></div>
                    </div>
                    <div class="relative flex justify-center text-xs uppercase font-bold tracking-wider">
                        <span class="px-4 bg-white text-slate-400">Ou continuer avec</span>
                    </div>
                </div>

                <!-- Register Link -->
                <div class="text-center">
                    <p class="text-slate-600 text-sm">
                        Pas encore de compte ?
                        <a href="{{ path('app_register') }}" class="text-party-purple hover:text-party-pink font-bold transition-colors ml-1">
                            Créer un compte gratuit
                        </a>
                    </p>
                </div>
            </div>

            <!-- Footer Link -->
            <p class="text-center mt-8">
                <a href="/" class="inline-flex items-center text-slate-400 hover:text-slate-600 text-sm font-medium transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                    </svg>
                    Retour à l'accueil
                </a>
            </p>
        </div>
    </div>
{% endblock %}
