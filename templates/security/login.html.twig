{% extends 'base.html.twig' %}

{% block title %}Connexion - Photo Gallery{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-md">
            <!-- Logo/Header -->
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Community Photos</h1>
                <p class="text-gray-600">Connectez-vous à votre compte</p>
            </div>

            <!-- Form Card -->
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 space-y-6">

                {% if error %}
                    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm">
                        {{ error.messageKey | trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" class="space-y-5">
                    <!-- Email Field -->
                    <div>
                        <label for="inputEmail" class="block text-sm font-medium text-gray-900 mb-2">
                            Adresse email
                        </label>
                        <input
                            type="email"
                            id="inputEmail"
                            name="email"
                            value="{{ last_username }}"
                            required
                            autofocus
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent outline-none transition"
                            placeholder="vous@exemple.com"
                        >
                    </div>

                    <!-- Password Field -->
                    <div>
                        <label for="inputPassword" class="block text-sm font-medium text-gray-900 mb-2">
                            Mot de passe
                        </label>
                        <input
                            type="password"
                            id="inputPassword"
                            name="password"
                            required
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:border-transparent outline-none transition"
                            placeholder="••••••••"
                        >
                    </div>

                    <!-- Remember Me -->
                    <div class="flex items-center">
                        <input
                            type="checkbox"
                            id="remember"
                            name="_remember_me"
                            class="w-4 h-4 text-teal-600 border-gray-300 rounded focus:ring-teal-500 cursor-pointer"
                        >
                        <label for="remember" class="ml-2 text-sm text-gray-700 cursor-pointer">
                            Se souvenir de moi
                        </label>
                    </div>

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        class="w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold py-2 px-4 rounded-lg transition duration-200 ease-in-out"
                    >
                        Se connecter
                    </button>
                </form>

                <!-- Divider -->
                <div class="relative">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-300"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-2 bg-white text-gray-500">ou</span>
                    </div>
                </div>

                <!-- Register Link -->
                <p class="text-center text-gray-600 text-sm">
                    Pas encore de compte ?
                    <a href="{{ path('app_register') }}" class="text-teal-600 hover:text-teal-700 font-semibold">
                        S'inscrire
                    </a>
                </p>
            </div>

            <!-- Footer Link -->
            <p class="text-center text-gray-500 text-xs mt-6">
                <a href="/" class="hover:text-gray-700">← Retour à l'accueil</a>
            </p>
        </div>
    </div>
{% endblock %}
